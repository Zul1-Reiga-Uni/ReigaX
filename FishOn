local function updateSelectedRodAttribute(rodName, enchant)
    local data = {
        Name    = rodName,
        Enchant = enchant or ""
    }
    local ok, json = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not ok then return false end

    local ok2 = pcall(function()
        LP:SetAttribute("SelectedRod", json)
    end)
    return ok2
end

-- core: ganti rod di target tertentu
-- targetType: "workspace" or "player"
local function changeRodModelCore(rodName, targetType)
    if isChanging then
        return false, "Processing, Wait"
    end

    isChanging = true

    local rodModels = ReplicatedFirst:FindFirstChild("RodModels")
    if not rodModels then
        isChanging = false
        return false, "Fail"
    end

    local selectedRod = rodModels:FindFirstChild(rodName)
    if not selectedRod then
        isChanging = false
        return false, "Rod '" .. rodName .. "' Not Found"
    end

    local handle = selectedRod:FindFirstChild("Handle")
    if not handle then
        isChanging = false
        return false, "Handle Part Not Found, MMK '" .. rodName .. "'"
    end

    -- select target rob
    local rodOnBack
    local targetLabel
    if targetType == "workspace" then
        rodOnBack   = getRodOnBack_Workspace()
        targetLabel = "workspace." .. LP.Name .. ".RodOnBack"
    elseif targetType == "player" then
        rodOnBack   = getRodOnBack_Player()
        targetLabel = "Character.RodOnBack"
    else
        isChanging = false
        return false, "Invalid Target"
    end

    if not rodOnBack then
        isChanging = false
        return false, "Rob Not Found In " .. targetLabel
    end

    -- 1: update attribute SelectedRod
    local rodEnchant = ""
    local rodData = parseSelection(LP:GetAttribute("SelectedRod"))
    if rodData and rodData.Enchant then
        rodEnchant = rodData.Enchant
    end
    updateSelectedRodAttribute(rodName, rodEnchant)

    task.wait(0.15)

    -- 2: Deleting Old ROB Contents
    for _, child in ipairs(rodOnBack:GetChildren()) do
        pcall(function() child:Destroy() end)
    end

    -- 3: clone handle contents
    local movedCount = 0
    for _, child in ipairs(handle:GetChildren()) do
        if child.Name ~= "Handle" then
            local ok, clone = pcall(function() return child:Clone() end)
            if ok and clone then
                clone.Parent = rodOnBack
                movedCount = movedCount + 1
            end
        end
    end

    task.wait(0.5)
    isChanging = false

    return true, string.format(
        "[%s] Rod '%s' (%d item)",
        targetLabel, rodName, movedCount
    )
end


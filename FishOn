-- auto-sync dropdown with SelectedRod attribute
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if userOverride then return end
            if isChanging then return end

            local selName = getSelectedRodName()
            if selName then
                if selName ~= selectedRodModel_WS then
                    selectedRodModel_WS = selName
                    if RodDropdown_WS and RodDropdown_WS.Set then
                        RodDropdown_WS:Set(selName)
                    end
                end
                if selName ~= selectedRodModel_Player then
                    selectedRodModel_Player = selName
                    if RodDropdown_Player and RodDropdown_Player.Set then
                        RodDropdown_Player:Set(selName)
                    end
                end
                Config.RodName = selName
            end
        end)
    end
end)

